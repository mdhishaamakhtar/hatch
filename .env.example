# Copy this file to .env and fill in the blanks before `make up`.
#
# scripts/inject-secrets.sh loads it into the hatch-secrets Secret, which
# every Hatch pod reads as its environment. HOST_* keys are left out of the
# Secret: they are for tools on this machine, reaching the cluster through
# `make port-forward`.

HOST_DATABASE_URL=postgres://hatch:hatchpass@localhost:5432/hatch?sslmode=disable
HOST_REDIS_ADDR=localhost:6379
HOST_KAFKA_BROKERS=localhost:9092

POSTGRES_PASSWORD=hatchpass
DATABASE_URL=postgres://hatch:hatchpass@postgres.hatch.svc.cluster.local:5432/hatch?sslmode=disable
REDIS_ADDR=redis.hatch.svc.cluster.local:6379
KAFKA_BROKERS=kafka.hatch.svc.cluster.local:9092
OTLP_ENDPOINT=observability-tempo.observability.svc.cluster.local:4317

# The bearer token for /admin, and for each scheduler's /internal.
ADMIN_API_KEY=changeme-admin-key
# The key provider credentials are encrypted with: `make gen-provider-key`.
PROVIDER_CRED_KEY=

# How far ahead a schedule has to be due. The default is 1h; `make verify`
# and the benchmarks schedule a few minutes ahead.
API_MIN_SCHEDULE_HORIZON=2m

# The mock provider, which development clients send through.
MOCK_PROVIDER_LATENCY=150ms
MOCK_PROVIDER_LATENCY_JITTER=50ms
MOCK_PROVIDER_ERROR_RATE=0.001
MOCK_PROVIDER_RATE_LIMIT_RATE=0

# `make verify` sends one real email through Resend, with this key and from
# this address, whose domain has to be verified in Resend. The recipient is
# Resend's test address, which accepts mail without delivering it anywhere.
VERIFY_RESEND_API_KEY=
VERIFY_RESEND_FROM=verify@nexia.hishaam.dev
VERIFY_RESEND_TO=delivered@resend.dev

{
  "uid": "hatch-benchmark",
  "title": "Hatch — Benchmark",
  "tags": ["hatch", "benchmark"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Lateness — deliver_at to delivered",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Lateness p50 (peak)",
      "description": "How long after its deliver_at the email actually went out. The wheel has one-second slots, so ~0-1s of this is scheduling resolution; the rest is queueing plus the provider call.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "options": { "reduceOptions": { "calcs": ["max"] }, "colorMode": "none" },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(hatch_delivery_e2e_latency_seconds_bucket[$__rate_interval])))" } ]
    },
    {
      "type": "stat",
      "title": "Lateness p95 (peak)",
      "description": "How long after its deliver_at the email actually went out. The wheel has one-second slots, so ~0-1s of this is scheduling resolution; the rest is queueing plus the provider call.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "options": { "reduceOptions": { "calcs": ["max"] }, "colorMode": "none" },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(hatch_delivery_e2e_latency_seconds_bucket[$__rate_interval])))" } ]
    },
    {
      "type": "stat",
      "title": "Lateness p99 (peak)",
      "description": "How long after its deliver_at the email actually went out. The wheel has one-second slots, so ~0-1s of this is scheduling resolution; the rest is queueing plus the provider call.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "options": { "reduceOptions": { "calcs": ["max"] }, "colorMode": "none" },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.99, sum by (le) (rate(hatch_delivery_e2e_latency_seconds_bucket[$__rate_interval])))" } ]
    },
    {
      "type": "stat",
      "title": "Peak delivered/sec",
      "description": "Highest sustained send rate in the window.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 1 } },
      "options": { "reduceOptions": { "calcs": ["max"] }, "colorMode": "none" },
      "targets": [ { "refId": "A", "expr": "sum(rate(hatch_delivery_sends_total{status=\"success\"}[$__rate_interval]))" } ]
    },
    {
      "type": "timeseries",
      "title": "Lateness over time",
      "description": "A burst run puts every schedule in one slot, so lateness climbs as the queue drains and then collapses — that sawtooth is the expected shape, not a fault.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(hatch_delivery_e2e_latency_seconds_bucket[$__rate_interval])))", "legendFormat": "p50" }, { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(hatch_delivery_e2e_latency_seconds_bucket[$__rate_interval])))", "legendFormat": "p95" }, { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(hatch_delivery_e2e_latency_seconds_bucket[$__rate_interval])))", "legendFormat": "p99" } ]
    },
    {
      "type": "heatmap",
      "title": "Lateness distribution",
      "description": "Where the mass actually sits. A single bright band means the histogram buckets cannot resolve this range.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
      "options": { "calculate": false, "cellGap": 1, "color": { "mode": "scheme", "scheme": "Turbo", "steps": 64 }, "yAxis": { "unit": "s" } },
      "targets": [ { "refId": "A", "expr": "sum by (le) (rate(hatch_delivery_e2e_latency_seconds_bucket[$__rate_interval]))", "format": "heatmap", "legendFormat": "{{le}}" } ]
    },
    {
      "type": "row",
      "title": "Pipeline funnel — where work enters and where it piles up",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Ingest vs fire vs deliver",
      "description": "Three independent capacities on one axis. A gap that opens and stays open is backpressure: work entered faster than the next stage drained it.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "refId": "A", "expr": "sum(rate(hatch_api_requests_total{endpoint=\"POST /v1/schedules\"}[$__rate_interval]))", "legendFormat": "1 · ingest (API creates/sec)" }, { "refId": "B", "expr": "sum(rate(hatch_scheduler_fired_total[$__rate_interval]))", "legendFormat": "2 · fire (scheduler → Kafka/sec)" }, { "refId": "C", "expr": "sum(rate(hatch_delivery_sends_total[$__rate_interval]))", "legendFormat": "3 · deliver (provider sends/sec)" } ]
    },
    {
      "type": "row",
      "title": "Stage 1 — Ingest (API)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Schedule creates by status",
      "description": "4xx during load is usually rate limiting or a deliver_at outside the horizon.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 25 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "refId": "A", "expr": "sum by (status_code) (rate(hatch_api_requests_total{endpoint=\"POST /v1/schedules\"}[$__rate_interval]))", "legendFormat": "{{status_code}}" } ]
    },
    {
      "type": "timeseries",
      "title": "API request latency",
      "description": "Latency climbing while throughput stays flat means requests are queueing for CPU.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 25 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(hatch_api_request_duration_seconds_bucket{endpoint=\"POST /v1/schedules\"}[$__rate_interval])))", "legendFormat": "p50" }, { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(hatch_api_request_duration_seconds_bucket{endpoint=\"POST /v1/schedules\"}[$__rate_interval])))", "legendFormat": "p95" }, { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(hatch_api_request_duration_seconds_bucket{endpoint=\"POST /v1/schedules\"}[$__rate_interval])))", "legendFormat": "p99" } ]
    },
    {
      "type": "timeseries",
      "title": "Rejections",
      "description": "",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 25 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "refId": "A", "expr": "sum(rate(hatch_api_rate_limited_total[$__rate_interval]))", "legendFormat": "rate limited" }, { "refId": "B", "expr": "sum by (reason) (rate(hatch_api_validation_failures_total[$__rate_interval]))", "legendFormat": "invalid: {{reason}}" } ]
    },
    {
      "type": "row",
      "title": "Stage 2 — Scheduler",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Schedules waiting in each wheel",
      "description": "Climbs on a poll, and falls as schedules fire.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 33 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "refId": "A", "expr": "hatch_scheduler_wheel_total_loaded", "legendFormat": "{{pod}}" } ]
    },
    {
      "type": "timeseries",
      "title": "Fired per second per pod",
      "description": "Schedules published to emails.due. Each tick publishes everything due in one batch.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 33 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "refId": "A", "expr": "sum by (pod) (rate(hatch_scheduler_fired_total[$__rate_interval]))", "legendFormat": "{{pod}}" } ]
    },
    {
      "type": "timeseries",
      "title": "Kafka produce latency p95 per pod",
      "description": "How long publishing one tick's batch took.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 33 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, pod) (rate(hatch_scheduler_kafka_produce_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "{{pod}}" } ]
    },
    {
      "type": "row",
      "title": "Stage 3 — Delivery",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Batch processing duration p95",
      "description": "Batch size divided by how many sends run at once, times provider latency.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 41 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(hatch_delivery_batch_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p95" } ]
    },
    {
      "type": "timeseries",
      "title": "Provider send duration",
      "description": "Buckets step .1 -> .25 -> .5, so a mock send at 150-199ms lands in one bucket and this reads as a constant. Treat it as a presence check, not a measurement.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 41 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le, provider) (rate(hatch_delivery_provider_send_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p50 {{provider}}" }, { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(hatch_delivery_provider_send_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p95 {{provider}}" } ]
    },
    {
      "type": "timeseries",
      "title": "Sends deferred without a provider call",
      "description": "Sends parked on a retry tier because every provider was rate limited (provider_no_capacity) or its circuit breaker was open (provider_breaker_open).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 41 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "refId": "A", "expr": "sum by (reason) (rate(hatch_delivery_deferred_total[$__rate_interval]))", "legendFormat": "{{reason}}" } ]
    },
    {
      "type": "timeseries",
      "title": "Outcomes",
      "description": "",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 48 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "refId": "A", "expr": "sum by (status) (rate(hatch_delivery_sends_total[$__rate_interval]))", "legendFormat": "send: {{status}}" }, { "refId": "B", "expr": "sum by (tier) (rate(hatch_delivery_retries_total[$__rate_interval]))", "legendFormat": "retry: {{tier}}" }, { "refId": "C", "expr": "sum by (reason) (rate(hatch_delivery_failed_total[$__rate_interval]))", "legendFormat": "failed: {{reason}}" } ]
    },
    {
      "type": "timeseries",
      "title": "Idempotency outcomes",
      "description": "duplicate_sent / duplicate_in_flight are the at-least-once guard doing its job.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 48 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "refId": "A", "expr": "sum by (result) (rate(hatch_delivery_idempotency_total[$__rate_interval]))", "legendFormat": "{{result}}" } ]
    }
  ]
}
